// For details on each supported attribute, refer to the autocompletion
// suggestions and tooltips provided by the IAR C-SPY Debug extension.

// With the IAR C-SPY Debug extension you can enable flexible workflows
// such as one to flash and launch the application in C-SPY, and another
// to reattach to the running target as needed:
//   "request": ":attach"
//   "leaveTargetRunning": true

// The driverOptions accepts an array with supported C-SPY command line
// options. For the complete reference, refer to:
// https://docs.iar.com/ewarm/10.1x/en/c-spy-debugging/the-c-spy-command-line-utility-cspybat.html
{
  "version": "0.2.0",
  "configurations": [
    {
    "name": "IAR Debug (Simulator)",
    "type": "cspy",
    "request": "launch", // "attach" also supported
    "target": "arm",
    "program": "$TARGET_PATH$",
    "stopOnSymbol": "main",
    "workbenchPath": "/iar/ewarmc-10.10.2/arm",
    "projectPath": "${workspaceRoot}",
    "driver": "Simulator",
    "driverOptions": [ // Match your Device/CPU/FPU/DDF
      "--endian=little",
      "--cpu=Cortex-M4",
      "--fpu=VFPv4_SP",
      "-p",
      "/iar/ewarmc-10.10.2/arm/config/debugger/ST/STM32F429II.ddf",
      "--semihosting",
      "--device=STM32F429II"
    ]
    },
    {
    "name": "IAR Debug (Linux/I-Jet/SWD)",
    "type": "cspy",
      "request": "launch", // "attach" also supported
      "leaveTargetRunning": false, // use true when request: attach
      "target": "arm",
      "program": "$TARGET_PATH$", //"$TARGET_PATH$",
      "stopOnSymbol": "main",
      "projectPath": "${workspaceRoot}",
      "workbenchPath": "/iar/ewarmc-10.10.2/arm",
      "driver": "I-jet",
      "driverOptions": [ // Match your Device/CPU/FPU/DDF
        "--endian=little",
        "--cpu=Cortex-M4",
        "--fpu=VFPv4_SP",
        "-p",
        "/iar/ewarmc-10.10.2/arm/config/debugger/ST/STM32F429II.ddf",
        "--device=STM32F429II",
        "--semihosting",
        "--jet_power_from_probe=leave_on",
        "--drv_interface=SWD",
        "--jet_cpu_clock=168000000",
        "--jet_standard_reset=2,10,10",
        "--drv_catch_exceptions=0xff0"
      ],
      "download": {
        "flashLoader": "/iar/ewarmc-10.10.2/arm/config/flashloader/ST/FlashSTM32F427xI.board",
        "deviceMacros": [
          "/iar/ewarmc-10.10.2/arm/config/debugger/ST/STM32F4xx.dmac"
        ]
      }
    },
    {
      "name": "IAR Debug (Linux/I-Jet/ETM)",
      "type": "cspy",
      "request": "launch",
      "leaveTargetRunning": false, // use true when request: attach
      "target": "arm",
      "program": "$TARGET_PATH$",
      "stopOnSymbol": "main",
      "projectPath": "${workspaceRoot}",
      "driver": "I-jet",
      "workbenchPath": "/iar/ewarmc-10.10.2/arm",
      "driverOptions": [ // Match your Device/CPU/FPU/DDF
        "--endian=little",
        "--cpu=Cortex-M4",
        "--fpu=VFPv4_SP",
        "-p",
        "/iar/ewarmc-10.10.2/arm/config/debugger/ST/STM32F429II.ddf",
        "--device=STM32F429II",
        "--semihosting",
        "--jet_power_from_probe=leave_on",
        "--drv_interface=SWD",
        "--jet_cpu_clock=168000000",
        "--drv_catch_exceptions=0xff0",
        "--drv_trace_settings=ETM"
      ],
      "download": {
        "flashLoader": "/iar/ewarmc-10.10.2/arm/config/flashloader/ST/FlashSTM32F427xI.board",
        "deviceMacros": [
          "/iar/ewarmc-10.10.2/arm/config/debugger/ST/STM32F4xx.dmac"
        ]
      }
    },
    {
      "name": "IAR Debug (Linux/J-Link)",
      "type": "cspy",
      "request": "launch",
      "leaveTargetRunning": false, // use true when request: attach
      "target": "arm",
      "program": "$TARGET_PATH$",
      "stopOnSymbol": "main",
      "projectPath": "${workspaceRoot}",
      "workbenchPath": "/iar/ewarmc-10.10.2/arm",
      "driver": "J-Link/J-Trace",
      "driverOptions": [ // Match your Device/CPU/FPU/DDF
        "--endian=little",
        "--cpu=Cortex-M4",
        "--fpu=VFPv4_SP",
        "-p",
        "/iar/ewarmc-10.10.2/arm/config/debugger/ST/STM32F429II.ddf",
        "--device=STM32F429II",
        "--semihosting",
        "--drv_communication=USB0",
        "--drv_interface_speed=auto",
        "--jlink_initial_speed=1000",
        "--jlink_reset_strategy=0,0",
        "--drv_interface=SWD",
        "--drv_catch_exceptions=0x000",
        "--drv_swo_clock_setup=168000000,0,2000000"
      ],
      //"download": {
      //  "flashLoader": "/iar/ewarmc-10.10.2/arm/config/flashloader/ST/FlashSTM32F427xI.board",
      //  "deviceMacros": [
      //    "/iar/ewarmc-10.10.2/arm/config/debugger/ST/STM32F4xx.dmac"
      //  ]
      //}
    }
  ]
}
