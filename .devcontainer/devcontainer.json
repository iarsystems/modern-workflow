{
  // IAR Build Tools for Arm (w/ ST device support)
  //   Update the image for use with other variants
  //   More information: https://github.com/iarsystems/containers/wiki/Arm-image-variants
  "image": "ghcr.io/iarsystems/arm:10.10.2-st",

  // Set the Container's environment variables
  "containerEnv": {
    "HOME": "/home/ubuntu",
    "IAR_LMS_BEARER_TOKEN": "${localEnv:IAR_LMS_BEARER_TOKEN}",
    "PIP_BREAK_SYSTEM_PACKAGES": "1"
  },

  // Customizations installs the IAR Extensions for VS Code
  // More information: https://iar.com/vscode
  "customizations": {
    "vscode": {
      "extensions": [
        //"iarsystems.iar-extension-pack",
        "iarsystems.iar-debug",
        "iarsystems.iar-login",
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-python.python",
        "ms-vscode.cmake-tools",
        "usernamehw.errorlens",
        "github.vscode-github-actions"
      ]
    }
  },

  "features": {
    // Update the IAR License Management System at build-time
    "./lmsc": {},
    // Install the J-Link driver
    "./jlink": {},
    // Install Python
    "ghcr.io/devcontainers/features/common-utils:2": {},
    "./python": {}
  },

  // Comment "remoteUser" and rebuild the container to become `root`.
  // More information: https://containers.dev/implementors/json_reference/#remoteUser
  "remoteUser": "ubuntu",

  // Exposes the host's USB bus to the dev container.
  "runArgs": [
    "--device=/dev/bus/usb"
  ],
  "privileged": true,

  // Update submodules and install cspy-mcp dependencies
  "postCreateCommand": "git submodule update --init --recursive && pip install -r cspy-mcp/requirements.txt"
}
